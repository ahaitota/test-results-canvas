# Bundled sample reports are dev-only fixtures — not shipped to users.
# The extension guards for a missing samples/ dir, so leaving it out is safe.
samples/

# Runtime/dev artifacts the extension may write while testing locally.
results.trx
*.log

# Playwright e2e artifacts
test-results/
playwright-report/
.playwright/

# Generated benchmark runs -- megabytes, and reproducible from the seed
# (npm run bench regenerates whatever is missing).
bench/fixtures/

# TypeScript build metadata (dist/ itself is committed so the app can load the
# extension straight from a checkout; remove that exception to require a build).
*.tsbuildinfo

# Temp config written by `npm run typecheck:sdk` (removed on exit).
tsconfig.sdk-check.json

# Dependencies / editor / OS cruft
node_modules/
.DS_Store
Thumbs.db

# VS Code extension build output — rebuilt with `npm run build:vscode`, and
# packaged into the .vsix rather than committed.
vscode/dist/
*.vsix
