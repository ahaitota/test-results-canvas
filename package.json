{
  "name": "test-results-canvas",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Copilot canvas extension that renders .NET TRX and JUnit XML test runs as a live UI panel.",
  "type": "module",
  "main": "dist/extension.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:client",
    "build:client": "esbuild src/client/main.tsx --bundle --outfile=dist/client/app.js --format=esm --target=es2022 --jsx=automatic --jsx-import-source=preact --alias:@bridge=./src/client/bridge.sse.ts --minify",
    "build:vscode": "npm run build:vscode:host && npm run build:vscode:client",
    "build:vscode:host": "esbuild vscode/src/extension.ts --bundle --outfile=vscode/dist/extension.js --platform=node --format=cjs --target=node20 --external:vscode --minify",
    "build:vscode:client": "esbuild src/client/main.tsx --bundle --outfile=vscode/dist/client/app.js --format=iife --target=es2022 --jsx=automatic --jsx-import-source=preact --alias:@bridge=./vscode/src/client/bridge.vscode.ts --minify",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:client": "tsc -p src/client/tsconfig.json",
    "typecheck:vscode": "tsc -p vscode/tsconfig.json",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "typecheck:bench": "tsc -p bench/tsconfig.json",
    "typecheck:sdk": "node --import tsx scripts/typecheck-sdk.ts",
    "lint": "eslint .",
    "test": "node --import tsx --test test/labels.test.ts test/trx.test.ts test/junit.test.ts test/validate.test.ts test/rowkey.test.ts test/ask.test.ts",
    "test:ci": "node -e \"require('node:fs').mkdirSync('test-results',{recursive:true})\" && node --import tsx --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/unit-junit.xml     test/labels.test.ts test/trx.test.ts test/junit.test.ts test/validate.test.ts test/rowkey.test.ts test/ask.test.ts",
    "test:e2e": "playwright test",
    "pretest:e2e": "npm run build",
    "bench": "playwright test --config=bench/playwright.bench.config.ts",
    "prebench": "npm run build",
    "bench:fixtures": "node --import tsx bench/gen-fixtures.ts"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "vscode"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@github/copilot-sdk": "^1.0.8",
    "@playwright/test": "^1.61.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "preact": "^10.29.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  }
}
