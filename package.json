{
  "name": "test-results-canvas",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Copilot canvas extension that renders .NET TRX and JUnit XML test runs as a live UI panel.",
  "type": "module",
  "main": "extension.mjs",
  "scripts": {
    "test": "node --test",
    "test:ci": "node -e \"require('node:fs').mkdirSync('test-results',{recursive:true})\" && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/unit-junit.xml",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
